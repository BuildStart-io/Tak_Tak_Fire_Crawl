# Firecrawl Self-Hosted API endpoint (default port 3002)
FIRECRAWL_API_URL=http://localhost:3002

# TakTak Jobs Ingestion API
TAKTAK_API_URL=https://taktakjobs.buildstart.io/api/public/jobs/ingest
INGEST_SECRET=your_ingest_secret_here

# Runner Configuration
DRY_RUN=true
MAX_JOBS_PER_BOARD=50
MIN_DELAY_MS=1000
MAX_DELAY_MS=3000
BATCH_SIZE=35

# Filter specific portals (e.g. PORTALS=topjobs,xpressjobs,rooster) or leave empty for all 20
PORTALS=
